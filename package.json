{
  "name": "ssh-chain",
  "version": "1.0.0",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "bun run index.ts",
    "dev": "bun run --watch index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "GIT_HASH=$(git rev-parse --short HEAD 2>/dev/null || echo '') && bun build --compile --minify --sourcemap --define \"BUILD_GIT_HASH='$GIT_HASH'\" ./index.ts --outfile dist/ssh-chain"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "ink": "^6.6.0",
    "proxy-chain": "^2.7.1",
    "react": "^19.2.3",
    "zod": "^4.3.6"
  }
}
